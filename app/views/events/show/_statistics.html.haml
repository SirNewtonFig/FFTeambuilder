  .rounded-lg.p-4.w-full.border.border-gray-700
    .text-sm.text-white.font-bold Hall of Shame
    .text-xs.text-gray-400 These are the options nobody decided to use this event.

    .mt-4
      .flex.flex-row.items-start
        .flex.flex-col.md:flex-row
          .mr-2.w-40.mb-2
            .mb-1.text-sm.text-white.font-bold Jobs
            - jobs = unused_jobs(event)
            - jobs.each do |job|
              .text-xs.text-gray-300= job.name
            - if jobs.blank?
              .text-xs.text-gray-500.italic All in use!

          .mr-2.w-40.mb-2
            .mb-1.text-sm.text-white.font-bold Reactions
            - skills = unused_reactions(event)
            - skills.each do |skill, job|
              .text-xs.text-gray-300.text-nowrap
                = skill
                %span.text-gray-500 • #{job}
              - if skills.blank?
                .text-xs.text-gray-500.italic All in use!

        .flex.flex-col.md:flex-row
          .mr-2.w-40.mb-2
            .mb-1.text-sm.text-white.font-bold Empowers
            - skills = unused_empowers(event)
            - skills.each do |skill, job|
              .text-xs.text-gray-300.text-nowrap
                = skill
                %span.text-gray-500 • #{job}
              - if skills.blank?
                .text-xs.text-gray-500.italic All in use!

          .mr-2.w-40.mb-2
            .mb-1.text-sm.text-white.font-bold Supports
            - skills = unused_supports(event)
            - skills.each do |skill, job|
              .text-xs.text-gray-300.text-nowrap
                = skill
                %span.text-gray-500 • #{job}
              - if skills.blank?
                .text-xs.text-gray-500.italic All in use!

      .mt-4
        - unused_skills = unused_actions(event).in_groups(4)
        .mb-1.text-sm.text-white.font-bold Skills
        .flex.flex-row.items-start
          .flex.flex-col.md:flex-row
            - unused_skills.first(2).each do |skills|
              .mr-2.w-40.mb-2
                - skills.each do |skill, job|
                  .text-xs.text-gray-300.text-nowrap
                    = skill
                    %span.text-gray-500 • #{job}
          .flex.flex-col.md:flex-row
            - unused_skills.last(2).each do |skills|
              .mr-2.w-40.mb-2
                - skills.each do |skill, job|
                  .text-xs.text-gray-300.text-nowrap
                    = skill
                    %span.text-gray-500 • #{job}

      .mt-4
        - weapons = unused_weapons(event).in_groups(4)
        .mb-1.text-sm.text-white.font-bold Weapons
        .flex.flex-row.items-start
          .flex.flex-col.md:flex-row
            - weapons.first(2).each do |items|
              .mr-2.w-40.mb-2
                - items.compact.each do |item|
                  .text-xs.text-gray-300
                    = item

          .flex.flex-col.md:flex-row
            - weapons.last(2).each do |items|
              .mr-2.w-40.mb-2
                - items.compact.each do |item|
                  .text-xs.text-gray-300
                    = item

      .mt-4
        .flex.flex-row.items-start
          .flex.flex-col.md:flex-row
            .mr-2.w-40.mb-2
              .mb-1.text-sm.text-white.font-bold Shields
              - shields = unused_shields(event)
              - shields.each do |shield|
                .text-xs.text-gray-300= shield
              - if shields.blank?
                .text-xs.text-gray-500.italic All in use!

            .mr-2.w-40.mb-2
              .mb-1.text-sm.text-white.font-bold Helmets
              - helmets = unused_helmets(event)
              - helmets.each do |helmet, job|
                .text-xs.text-gray-300= helmet
              - if helmets.blank?
                .text-xs.text-gray-500.italic All in use!

          .flex.flex-col.md:flex-row
            .mr-2.w-40.mb-2
              .mb-1.text-sm.text-white.font-bold Armor
              - armors = unused_armors(event)
              - armors.each do |armor|
                .text-xs.text-gray-300= armor
              - if armors.blank?
                .text-xs.text-gray-500.italic All in use!

            .mr-2.w-40.mb-2
              .mb-1.text-sm.text-white.font-bold Accessories
              - accessories = unused_accessories(event)
              - accessories.each do |accessory, job|
                .text-xs.text-gray-300= accessory
              - if accessories.blank?
                .text-xs.text-gray-500.italic All in use!
